{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:evidence-table:v1",
  "title": "Evidence table",
  "description": "Body of an 'evidence' artifact: claims taken from a cited review, each with its source and how it bears on each hypothesis (the scientific-research profile).",
  "type": "object",
  "required": [
    "schema",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "evidence-table@1.0"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "bears",
          "strength"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[1-9][0-9]{0,2}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source": {
            "type": "string",
            "pattern": "^https?://",
            "maxLength": 2048
          },
          "bears": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "hypothesis",
                "direction"
              ],
              "properties": {
                "hypothesis": {
                  "type": "string",
                  "pattern": "^H[1-9][0-9]?$"
                },
                "direction": {
                  "enum": [
                    "supports",
                    "refutes",
                    "neutral"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "strength": {
            "enum": [
              "strong",
              "moderate",
              "weak"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

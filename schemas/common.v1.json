{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:common:v1",
  "title": "Common definitions",
  "description": "Shared value types referenced by every system schema.",
  "$defs": {
    "schemaTag": {
      "description": "Schema name and version of a record: <name>@<major>.<minor>.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "description": "Content address: 'sha256:' followed by 64 lowercase hex characters.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactRef": { "$ref": "#/$defs/sha256" },
    "timestamp": { "type": "string", "format": "date-time" },
    "id": {
      "description": "Stable, human-readable identifier (deterministic node ids, account ids, policy ids).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "classification": {
      "description": "Data classification driving egress policy (INV-12).",
      "enum": ["public", "operator-shared", "local-private"]
    },
    "tier": {
      "description": "Intelligence tier (purpose P4).",
      "enum": ["economy", "standard", "frontier"]
    },
    "quotaClass": {
      "description": "Quota class of a Worker (purpose P1).",
      "enum": ["subscription-chat", "agent-plan", "metered", "local"]
    },
    "workScope": {
      "description": "A kind of work a scoped capability offer is limited to (ADR-0049): review-member, a step of a review team's member.",
      "enum": ["review-member"]
    },
    "capability": {
      "description": "Named capability; 'connector:<name>' for website connectors.",
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*|connector:[a-z0-9][a-z0-9_-]*)$"
    },
    "sideEffectClass": {
      "description": "Effect class used by restart reconciliation (INV-4).",
      "enum": ["none", "idempotent", "reconcilable", "irreversible"]
    },
    "subject": {
      "description": "Exact subject an artifact or gate is bound to (INV-5).",
      "type": "object",
      "required": ["type", "ref"],
      "properties": {
        "type": { "enum": ["content", "git-head", "pull-request", "artifact", "external"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "semver": {
      "description": "Semantic version MAJOR.MINOR.PATCH, with an optional pre-release.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]{1,64})?$",
      "maxLength": 100
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 500 },
    "actionClass": {
      "description": "What an action does, as the autonomy policy classifies it (design/approvals.md).",
      "enum": ["read", "workspace-write", "merge", "command", "external-send", "deploy", "delete-data", "spend", "charter", "funding", "remediation", "policy-change"]
    },
    "budgetLine": {
      "description": "An amount of one resource pool (design/resources.md). Pools are operator configuration, never a hardcoded plan.",
      "type": "object",
      "required": ["pool", "unit", "amount"],
      "properties": {
        "pool": { "$ref": "#/$defs/id" },
        "unit": { "enum": ["tokens", "usd", "turns", "runs", "minutes"] },
        "amount": { "type": "number", "minimum": 0, "maximum": 1000000000000 }
      },
      "additionalProperties": false
    },
    "tokenCount": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
    "tokenUsage": {
      "description": "Token counts named after the OpenTelemetry GenAI usage attributes. inputTokens includes cached input; cacheReadInputTokens and cacheCreationInputTokens are subsets of it.",
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/tokenCount" },
        "outputTokens": { "$ref": "#/$defs/tokenCount" },
        "cacheReadInputTokens": { "$ref": "#/$defs/tokenCount" },
        "cacheCreationInputTokens": { "$ref": "#/$defs/tokenCount" },
        "reasoningOutputTokens": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    }
  }
}

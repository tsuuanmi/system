{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:agent-result:v1",
  "title": "Agent result",
  "description": "Body of a `report` artifact holding one agent-runtime Worker run's final message (design/agent-runtimes.md). The prompt is referenced by hash only; the agent's own session stays native and is named by its handle.",
  "type": "object",
  "required": [
    "schema",
    "worker",
    "runtime",
    "runId",
    "promptHash",
    "sandbox",
    "text"
  ],
  "properties": {
    "schema": {
      "enum": [
        "agent-result@1.0",
        "agent-result@1.1",
        "agent-result@1.2",
        "agent-result@1.3",
        "agent-result@1.4"
      ],
      "description": "1.1 adds `workspace` and `subject`; 1.2 adds `model`, `usage`, and `models`; 1.3 adds `profile` and `replay` (ADR-0049); 1.4 adds `tier` and `configuredModel` (ADR-0073)."
    },
    "tier": {
      "description": "@1.4: the tier the run ran at, of the tiers its Worker offers (ADR-0073): the one routing served the work at.",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tier"
    },
    "configuredModel": {
      "description": "@1.4: the model the operator's configuration gives the Worker at that tier, which the run asked its runtime for (`model` is the one the runtime reports it answered with). Configuration, never a routing input.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "worker": {
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
    },
    "runtime": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9:-]*$",
      "maxLength": 64
    },
    "runId": {
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
    },
    "sessionId": {
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
    },
    "nativeHandle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "promptHash": {
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/sha256"
    },
    "sandbox": {
      "enum": [
        "read-only",
        "workspace-write"
      ]
    },
    "workspace": {
      "description": "Absolute path of the workspace the agent worked in: the configured workspace, or its workflow run's own git worktree of it (worktreePerRun). From operator configuration, never model text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "subject": {
      "description": "The workspace's exact subject after the run (a git working tree), when it is a repository.",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/subject"
    },
    "turns": {
      "type": "integer",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "model": {
      "description": "The model the run's main loop answered with, as the runtime reports it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "usage": {
      "description": "Token usage of the whole run, every model and subagent included, from the runtime's own result (the Agent SDK's modelUsage).",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tokenUsage"
    },
    "models": {
      "description": "The same usage split per model.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "model",
          "usage"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "usage": {
            "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tokenUsage"
          },
          "costUsd": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "profile": {
      "description": "@1.3: the profile the run's step ran under (ADR-0049): `review-member`, a review team member's step, in which the run's gate denied every tool call, so its answer rests on its prompt alone.",
      "enum": [
        "review-member"
      ]
    },
    "replay": {
      "description": "@1.3: the conversation this run continued by replay, its runtime keeping none (ADR-0049): the earlier runs of its session it was sent, in order, each its message and its answer exactly as they were, and the hash of everything it was sent. The answers are also the artifact's inputs.",
      "type": "object",
      "required": [
        "runs",
        "answers",
        "promptHash"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
          }
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef"
          }
        },
        "promptHash": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "allOf": [
    {
      "description": "@1.2 fields (model and token usage) are refused before @1.2.",
      "if": {
        "anyOf": [
          {
            "properties": {
              "model": {
                "type": "string"
              }
            },
            "required": [
              "model"
            ]
          },
          {
            "properties": {
              "usage": {
                "type": "object"
              }
            },
            "required": [
              "usage"
            ]
          },
          {
            "properties": {
              "models": {
                "type": "array"
              }
            },
            "required": [
              "models"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "schema": {
            "enum": [
              "agent-result@1.2",
              "agent-result@1.3",
              "agent-result@1.4"
            ]
          }
        }
      }
    },
    {
      "description": "@1.3 fields (profile and replay) are refused before @1.3.",
      "if": {
        "anyOf": [
          {
            "properties": {
              "profile": {
                "type": "string"
              }
            },
            "required": [
              "profile"
            ]
          },
          {
            "properties": {
              "replay": {
                "type": "object"
              }
            },
            "required": [
              "replay"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "schema": {
            "enum": [
              "agent-result@1.3",
              "agent-result@1.4"
            ]
          }
        }
      }
    },
    {
      "description": "@1.4 fields (tier and configuredModel) are refused before @1.4.",
      "if": {
        "anyOf": [
          {
            "properties": {
              "tier": {
                "type": "string"
              }
            },
            "required": [
              "tier"
            ]
          },
          {
            "properties": {
              "configuredModel": {
                "type": "string"
              }
            },
            "required": [
              "configuredModel"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "schema": {
            "const": "agent-result@1.4"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

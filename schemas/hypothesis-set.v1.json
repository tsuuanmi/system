{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:hypothesis-set:v1",
  "title": "Hypothesis set",
  "description": "Body of a 'criteria' artifact: a research question framed as testable hypotheses, each with what would support or refute it (the scientific-research profile).",
  "type": "object",
  "required": [
    "schema",
    "question",
    "hypotheses"
  ],
  "properties": {
    "schema": {
      "const": "hypothesis-set@1.0"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H[1-9][0-9]?$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "supportIf": {
            "type": "string",
            "maxLength": 2000
          },
          "refuteIf": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

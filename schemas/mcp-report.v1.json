{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:mcp-report:v1",
  "title": "MCP report tool",
  "description": "Input and output of the `report` MCP tool (design/reports.md): the baseline report of PROP-0010 B8, computed by code from recorded data only (the board, the approval queue, the resource ledger, the event log, and the decisions they name) over a period and one project or every one. The root describes one call (tool, input, structured output); a provider validates input and output against `#/$defs/report-input` and `#/$defs/report-output`. 1.1 adds what a cap counts as 0; 1.2 adds `attention.liveness`, the agent runs whose liveness asked for the operator. 1.3 adds `attention.reviewsHeld`, the reviews held for the operator and when each expires. 1.4 adds `usage.draws`, the quota agent runs drew per kind, template step, and window.",
  "type": "object",
  "required": [
    "tool",
    "input",
    "output"
  ],
  "properties": {
    "tool": {
      "const": "report"
    },
    "input": {
      "$ref": "#/$defs/report-input"
    },
    "output": {
      "$ref": "#/$defs/report-output"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "date": {
      "description": "A UTC calendar date.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "taskStates": {
      "description": "Tasks per state, as the board holds them when the report reads it (`asOf`).",
      "type": "object",
      "required": [
        "proposed",
        "ready",
        "claimed",
        "running",
        "review",
        "waiting-for-input",
        "waiting-for-approval",
        "done",
        "cancelled"
      ],
      "properties": {
        "proposed": {
          "$ref": "#/$defs/count"
        },
        "ready": {
          "$ref": "#/$defs/count"
        },
        "claimed": {
          "$ref": "#/$defs/count"
        },
        "running": {
          "$ref": "#/$defs/count"
        },
        "review": {
          "$ref": "#/$defs/count"
        },
        "waiting-for-input": {
          "$ref": "#/$defs/count"
        },
        "waiting-for-approval": {
          "$ref": "#/$defs/count"
        },
        "done": {
          "$ref": "#/$defs/count"
        },
        "cancelled": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "description": "Counted usage records and what they consumed: tokens as the ledger counts them (input includes cached input), turns, and the runtime's own cost estimate; and, from 1.1, what a cap counts as 0.",
      "type": "object",
      "required": [
        "records",
        "inputTokens",
        "outputTokens",
        "cacheReadInputTokens",
        "cacheCreationInputTokens",
        "turns",
        "costUsd"
      ],
      "properties": {
        "records": {
          "$ref": "#/$defs/count"
        },
        "inputTokens": {
          "$ref": "#/$defs/tokens"
        },
        "outputTokens": {
          "$ref": "#/$defs/tokens"
        },
        "cacheReadInputTokens": {
          "$ref": "#/$defs/tokens"
        },
        "cacheCreationInputTokens": {
          "$ref": "#/$defs/tokens"
        },
        "turns": {
          "$ref": "#/$defs/count"
        },
        "costUsd": {
          "$ref": "#/$defs/usd"
        },
        "withoutTokens": {
          "description": "Counted records that carry no token counts: a tokens cap counts them as 0. Absent: none.",
          "$ref": "#/$defs/count"
        },
        "withoutCost": {
          "description": "Counted records that carry no cost: a usd cap counts them as 0. Absent: none.",
          "$ref": "#/$defs/count"
        },
        "withoutTurns": {
          "description": "Counted records that carry no turn count: a turns cap counts them as 0. Absent: none.",
          "$ref": "#/$defs/count"
        },
        "unknownRuns": {
          "description": "Runs recorded in the period whose usage the ledger could not count (`usage.unknown`) and has not counted a record of since (its own lower bound never counts as one): a figure counts at most that lower bound, and a cap of their task or project in their pool is refused (1.1; ADR-0065). Absent: none.",
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "points": {
      "description": "Percentage points of a window's allowance.",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "drawFigure": {
      "description": "One group of quota draws (1.4): its kind of work (absent: runs admitted for none), with `byStep` its template and step, its window, the clean draws counted, their median and 90th percentile (nearest rank) in percentage points (absent with none), and the entries left out of the figures by state.",
      "type": "object",
      "required": [
        "window",
        "draws",
        "excluded"
      ],
      "properties": {
        "kind": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/workKind"
        },
        "template": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "step": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "window": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "draws": {
          "$ref": "#/$defs/count"
        },
        "median": {
          "$ref": "#/$defs/points"
        },
        "p90": {
          "$ref": "#/$defs/points"
        },
        "excluded": {
          "type": "object",
          "required": [
            "confounded",
            "reset-crossing",
            "no-reading"
          ],
          "properties": {
            "confounded": {
              "$ref": "#/$defs/count"
            },
            "reset-crossing": {
              "$ref": "#/$defs/count"
            },
            "no-reading": {
              "$ref": "#/$defs/count"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "report-input": {
      "type": "object",
      "properties": {
        "projectId": {
          "description": "One project; absent: every project on the board (the studio).",
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "since": {
          "description": "The period's start (inclusive). With neither since nor days, the period is the 7 days before until.",
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
        },
        "until": {
          "description": "The period's end (exclusive); default the time of the call.",
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
        },
        "days": {
          "description": "The period as the days before until; not with since.",
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        }
      },
      "not": {
        "required": [
          "since",
          "days"
        ],
        "properties": {
          "since": true,
          "days": true
        }
      },
      "additionalProperties": false
    },
    "report-output": {
      "type": "object",
      "required": [
        "period",
        "asOf",
        "projects",
        "tasks",
        "attempts",
        "remediation",
        "approvals",
        "attention",
        "usage",
        "digests",
        "baseline",
        "notes"
      ],
      "properties": {
        "period": {
          "description": "The period counted: from since (inclusive) to until (exclusive), at most 366 days.",
          "type": "object",
          "required": [
            "since",
            "until"
          ],
          "properties": {
            "since": {
              "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
            },
            "until": {
              "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
            }
          },
          "additionalProperties": false
        },
        "projectId": {
          "description": "The project reported on; absent: every project.",
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "asOf": {
          "description": "When the board and the queue were read: the `now` counts are as of then, whatever the period.",
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
        },
        "projects": {
          "description": "The projects reported on, by id: each one's state, charter, milestones, and tasks now.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "projectId",
              "title",
              "state",
              "charterVersion",
              "milestones",
              "tasks"
            ],
            "properties": {
              "projectId": {
                "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "state": {
                "enum": [
                  "proposed",
                  "active",
                  "paused",
                  "closed"
                ]
              },
              "charterVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "milestones": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "state"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "state": {
                      "enum": [
                        "planned",
                        "funded",
                        "done",
                        "dropped"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "attention": {
                "description": "The charter's attention budget, when it sets one.",
                "type": "object",
                "properties": {
                  "maxBatchesPerDay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "maxInterruptionsPerDay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  }
                },
                "additionalProperties": false
              },
              "tasks": {
                "$ref": "#/$defs/taskStates"
              }
            },
            "additionalProperties": false
          }
        },
        "projectsOmitted": {
          "description": "Projects counted but not listed, past the first 100 by id.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "tasks": {
          "type": "object",
          "required": [
            "now",
            "created",
            "done",
            "doneByOperator",
            "cancelled"
          ],
          "properties": {
            "now": {
              "$ref": "#/$defs/taskStates"
            },
            "created": {
              "description": "Tasks proposed in the period.",
              "$ref": "#/$defs/count"
            },
            "done": {
              "description": "Tasks whose accepting acceptance decision was made in the period: the accepted results.",
              "$ref": "#/$defs/count"
            },
            "doneByOperator": {
              "description": "Of those, accepted by the operator's own decision (a review held for the operator).",
              "$ref": "#/$defs/count"
            },
            "cancelled": {
              "description": "Tasks cancelled in the period.",
              "$ref": "#/$defs/count"
            }
          },
          "additionalProperties": false
        },
        "attempts": {
          "description": "Runs whose outcome reached their task in the period (`workflow.task.reported`), one per attempt.",
          "type": "object",
          "required": [
            "reported",
            "accepted",
            "rejected",
            "heldForOperator",
            "reconciled",
            "other",
            "review"
          ],
          "properties": {
            "reported": {
              "$ref": "#/$defs/count"
            },
            "accepted": {
              "description": "Accepted by the run's own acceptance decision: the task done.",
              "$ref": "#/$defs/count"
            },
            "rejected": {
              "description": "Rejected by a check the run ran itself: another attempt, without the operator.",
              "$ref": "#/$defs/count"
            },
            "heldForOperator": {
              "description": "Held for the operator's acceptance: a required check not reported.",
              "$ref": "#/$defs/count"
            },
            "reconciled": {
              "description": "Reported with reconcileRun and neither accepted nor held: a failed or stopped run, or one whose holder was lost.",
              "$ref": "#/$defs/count"
            },
            "other": {
              "description": "Refused, moved on, or never started.",
              "$ref": "#/$defs/count"
            },
            "review": {
              "description": "The exact-subject review the run's acceptance decision reports, by attempt: passed (approved), failed (changes still requested), or none bound to the result.",
              "type": "object",
              "required": [
                "passed",
                "failed",
                "none"
              ],
              "properties": {
                "passed": {
                  "$ref": "#/$defs/count"
                },
                "failed": {
                  "$ref": "#/$defs/count"
                },
                "none": {
                  "$ref": "#/$defs/count"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "remediation": {
          "description": "Remediation of blocking review findings in the period: cycles grown, and fixes the approval queue opened or closed.",
          "type": "object",
          "required": [
            "cycles",
            "fixesOpened",
            "fixesClosed"
          ],
          "properties": {
            "cycles": {
              "$ref": "#/$defs/count"
            },
            "fixesOpened": {
              "$ref": "#/$defs/count"
            },
            "fixesClosed": {
              "$ref": "#/$defs/count"
            }
          },
          "additionalProperties": false
        },
        "approvals": {
          "type": "object",
          "required": [
            "asked",
            "approved",
            "rejected",
            "expired",
            "withdrawn",
            "openNow",
            "byClass"
          ],
          "properties": {
            "asked": {
              "description": "Requests made in the period.",
              "$ref": "#/$defs/count"
            },
            "approved": {
              "description": "Approved by the operator in the period.",
              "$ref": "#/$defs/count"
            },
            "rejected": {
              "description": "Rejected by the operator's verdict in the period.",
              "$ref": "#/$defs/count"
            },
            "expired": {
              "description": "Expired unanswered in the period (denied).",
              "$ref": "#/$defs/count"
            },
            "withdrawn": {
              "description": "Withdrawn in the period: the waiting work ended first, or the policy changed.",
              "$ref": "#/$defs/count"
            },
            "openNow": {
              "description": "Open or batched as of asOf.",
              "$ref": "#/$defs/count"
            },
            "byClass": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": [
                  "actionClass",
                  "asked",
                  "approved",
                  "rejected",
                  "expired",
                  "withdrawn"
                ],
                "properties": {
                  "actionClass": {
                    "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/actionClass"
                  },
                  "asked": {
                    "$ref": "#/$defs/count"
                  },
                  "approved": {
                    "$ref": "#/$defs/count"
                  },
                  "rejected": {
                    "$ref": "#/$defs/count"
                  },
                  "expired": {
                    "$ref": "#/$defs/count"
                  },
                  "withdrawn": {
                    "$ref": "#/$defs/count"
                  }
                },
                "additionalProperties": false
              }
            },
            "wait": {
              "description": "From a request's creation to the operator's verdict, over the verdicts given in the period; nearest-rank percentiles. Absent with no verdict.",
              "type": "object",
              "required": [
                "answered",
                "medianSeconds",
                "p90Seconds",
                "maxSeconds"
              ],
              "properties": {
                "answered": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                },
                "medianSeconds": {
                  "$ref": "#/$defs/seconds"
                },
                "p90Seconds": {
                  "$ref": "#/$defs/seconds"
                },
                "maxSeconds": {
                  "$ref": "#/$defs/seconds"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "attention": {
          "description": "What asked for the operator in the period: approval requests made and reviews held for the operator (interruptions), and the batches shown (a batch the queue made, or a request answered alone), per UTC day.",
          "type": "object",
          "required": [
            "interruptions",
            "batches",
            "days"
          ],
          "properties": {
            "interruptions": {
              "$ref": "#/$defs/count"
            },
            "batches": {
              "$ref": "#/$defs/count"
            },
            "days": {
              "description": "The days with any interruption or batch, in order.",
              "type": "array",
              "maxItems": 367,
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "interruptions",
                  "batches"
                ],
                "properties": {
                  "date": {
                    "$ref": "#/$defs/date"
                  },
                  "interruptions": {
                    "$ref": "#/$defs/count"
                  },
                  "batches": {
                    "$ref": "#/$defs/count"
                  },
                  "over": {
                    "description": "Set when the day is over the project's charter thresholds.",
                    "const": true
                  }
                },
                "additionalProperties": false
              }
            },
            "threshold": {
              "description": "The project's charter attention budget, for a report on one project that sets one.",
              "type": "object",
              "properties": {
                "maxBatchesPerDay": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "maxInterruptionsPerDay": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "additionalProperties": false
            },
            "daysOver": {
              "description": "Days over the threshold, with one.",
              "$ref": "#/$defs/count"
            },
            "liveness": {
              "description": "1.2: the agent runs whose liveness asked for the operator in the period (PROP-0013), only when there is any: stalls reported (`agent-workers.run.stalled`), runs that ended without being known to be gone, their session and worktree held until the operator frees them (`agent-workers.run.unknown`), and runs the operator freed (`agent-workers.run.freed`); `held`, those that ended unknown in the period and were not freed in it, the latest first. Not counted as interruptions.",
              "type": "object",
              "required": [
                "stalled",
                "unknown",
                "freed",
                "held"
              ],
              "properties": {
                "stalled": {
                  "$ref": "#/$defs/count"
                },
                "unknown": {
                  "$ref": "#/$defs/count"
                },
                "freed": {
                  "$ref": "#/$defs/count"
                },
                "held": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "required": [
                      "agentRun",
                      "worker",
                      "at"
                    ],
                    "properties": {
                      "agentRun": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "worker": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "at": {
                        "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
                      },
                      "runId": {
                        "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "heldOmitted": {
                  "description": "Held runs counted but not listed, past the latest 64.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                }
              },
              "additionalProperties": false
            },
            "reviewsHeld": {
              "description": "1.3: the board tasks whose review is held for the operator as the report is made (`operator-review`), the soonest to expire first, only when there is any: each expires unseen at `expiresAt`, and its task then waits for input (`review-expired`).",
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "taskId",
                  "projectId",
                  "title",
                  "expiresAt",
                  "pendingChecks"
                ],
                "properties": {
                  "taskId": {
                    "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
                  },
                  "projectId": {
                    "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "expiresAt": {
                    "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
                  },
                  "pendingChecks": {
                    "description": "The class's required checks the acceptance did not report passed, as the task's `waiting.pendingChecks` names them.",
                    "type": "array",
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "tests",
                        "typecheck",
                        "lint",
                        "schema",
                        "quote-check",
                        "review"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "reviewsHeldOmitted": {
              "description": "1.3: held reviews counted but not listed, past the first 64.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          },
          "additionalProperties": false
        },
        "usage": {
          "description": "The ledger's counted usage records observed in the period (for one project: those naming it or one of its tasks, or the run or execution that served one of its tasks).",
          "type": "object",
          "required": [
            "total",
            "pools",
            "byOutcome"
          ],
          "properties": {
            "total": {
              "$ref": "#/$defs/usage"
            },
            "pools": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/poolUsage"
              }
            },
            "byOutcome": {
              "type": "object",
              "required": [
                "completed",
                "failed",
                "aborted",
                "unknown"
              ],
              "properties": {
                "completed": {
                  "$ref": "#/$defs/count"
                },
                "failed": {
                  "$ref": "#/$defs/count"
                },
                "aborted": {
                  "$ref": "#/$defs/count"
                },
                "unknown": {
                  "$ref": "#/$defs/count"
                }
              },
              "additionalProperties": false
            },
            "unknown": {
              "description": "The runs recorded in the period whose usage the ledger could not count (`usage-unknown@1.0`), each once by the kind of its first entry, and how many of them it has counted a record of since (reconciled). Absent: none (1.1).",
              "type": "object",
              "required": [
                "runs",
                "reconciled",
                "notReported",
                "interrupted",
                "refused",
                "failed"
              ],
              "properties": {
                "runs": {
                  "$ref": "#/$defs/count"
                },
                "reconciled": {
                  "$ref": "#/$defs/count"
                },
                "notReported": {
                  "$ref": "#/$defs/count"
                },
                "interrupted": {
                  "$ref": "#/$defs/count"
                },
                "refused": {
                  "$ref": "#/$defs/count"
                },
                "failed": {
                  "$ref": "#/$defs/count"
                }
              },
              "additionalProperties": false
            },
            "draws": {
              "description": "1.4: what agent runs ended in the period drew from their accounts' windows (`quota-draw@1.0`, PROP-0015 E2), per kind and window and per kind, template step, and window: the clean draws counted, their median and 90th percentile in percentage points, and the entries left out by why. Absent: none recorded.",

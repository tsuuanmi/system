{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:capability-descriptor:v1",
  "title": "Worker capability snapshot",
  "description": "What a Worker has proven right now; input to admission (design/routing.md).",
  "type": "object",
  "required": ["schema", "worker", "provider", "tier", "quotaClass", "locality", "capabilities", "state", "observedAt"],
  "properties": {
    "schema": { "enum": ["capability-descriptor@1.0", "capability-descriptor@1.1", "capability-descriptor@1.2", "capability-descriptor@1.3", "capability-descriptor@1.4", "capability-descriptor@1.5", "capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] },
    "worker": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "provider": { "description": "Provider plugin kind; never used for routing semantics (INV-11).", "type": "string", "maxLength": 64 },
    "family": { "description": "@1.1: opaque provider family its Worker source sets; routing only compares it for inequality (ADR-0027).", "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "description": "@1.7: what the Worker is for, in the operator's words: its configuration's `description` (a website Worker's is its account's, with the tier). For people only; routing never reads it.", "type": "string", "minLength": 1, "maxLength": 256 },
    "title": { "description": "@1.8: the Worker's name for people, as its source gives it: a website provider's own title (its driver's), or a model's from the operator's catalog entry. The roster's display name starts with it; routing never reads it.", "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "maxInputChars": { "description": "@1.2: the longest input this Worker takes, in characters (code points) of what it is sent; admission refuses longer input (ADR-0032).", "type": "integer", "minimum": 1 },
    "load": {
      "description": "@1.3: how busy the Worker's runtime is: turns running in its slots, queued, and routed to it but not started (pending); among equally ranked Workers the least busy is routed to (ADR-0033).",
      "type": "object",
      "required": ["running", "queued", "pending", "slots"],
      "properties": {
        "running": { "type": "integer", "minimum": 0 },
        "queued": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "slots": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "cooldowns": {
      "description": "@1.3: capabilities it proves but may not use until `until`, a site's usage limit; work that needs one is not admitted here (ADR-0034).",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["capability", "until"],
        "properties": {
          "capability": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/capability" },
          "until": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    },
    "account": {
      "description": "@1.5: the account the Worker runs on, as opaque values its source sets (ADR-0052): `id` the account, `group` the accounts it is compared with (a website's provider, an agent runtime), `mode` that group's setting. Under `assigned`, a limit on one account never moves its work to another account of its group. `limitUntil`: when an account whose Worker reads quota-exhausted is expected back, when its source knows. Routing compares id and group for equality only (INV-11).",
      "type": "object",
      "required": ["id", "group", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "group": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mode": { "enum": ["assigned", "pooled"] },
        "limitUntil": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "kinds": {
      "description": "@1.6: the kinds of work the operator gives this Worker (ADR-0057): it takes only work whose requirement names one of them, never work of another kind or of none. Absent: it takes work of any kind, or of none.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/workKind" }
    },
    "tier": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tier" },
    "quotaClass": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/quotaClass" },
    "locality": { "enum": ["local", "remote"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["capability", "evidence"],
        "properties": {
          "capability": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/capability" },
          "evidence": {
            "type": "object",
            "required": ["kind", "at"],
            "properties": {
              "kind": { "enum": ["probe", "conformance", "plan", "sandbox-policy"] },
              "ref": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef" },
              "at": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp" }
            },
            "additionalProperties": false
          },
          "sideEffectClass": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/sideEffectClass" },
          "scope": {
            "description": "@1.4: the capability is proven only for work of this scope (a work requirement naming it), never for other work (ADR-0049).",
            "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/workScope"
          }
        },
        "additionalProperties": false
      }
    },
    "state": { "enum": ["ready", "busy", "quota-exhausted", "reauth-required", "unavailable"] },
    "observedAt": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "family": { "type": "string" } }, "required": ["family"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.1", "capability-descriptor@1.2", "capability-descriptor@1.3", "capability-descriptor@1.4", "capability-descriptor@1.5", "capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "maxInputChars": { "type": "integer" } }, "required": ["maxInputChars"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.2", "capability-descriptor@1.3", "capability-descriptor@1.4", "capability-descriptor@1.5", "capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "cooldowns": { "type": "array" } }, "required": ["cooldowns"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.3", "capability-descriptor@1.4", "capability-descriptor@1.5", "capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "load": { "type": "object" } }, "required": ["load"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.3", "capability-descriptor@1.4", "capability-descriptor@1.5", "capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "capabilities": { "type": "array", "contains": { "type": "object", "properties": { "scope": { "type": "string" } }, "required": ["scope"] } } }, "required": ["capabilities"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.4", "capability-descriptor@1.5", "capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "account": { "type": "object" } }, "required": ["account"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.5", "capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "kinds": { "type": "array" } }, "required": ["kinds"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.6", "capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "description": { "type": "string" } }, "required": ["description"] },
      "then": { "properties": { "schema": { "enum": ["capability-descriptor@1.7", "capability-descriptor@1.8"] } } }
    },
    {
      "if": { "properties": { "title": { "type": "string" } }, "required": ["title"] },
      "then": { "properties": { "schema": { "const": "capability-descriptor@1.8" } } }
    }
  ]
}

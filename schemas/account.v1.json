{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:account:v1",
  "title": "Provider account record",
  "description": "Vault record for one provider account (design/browser-runtime.md). Stored 0600; never leaves the provider runtime (INV-8).",
  "type": "object",
  "required": [
    "schema",
    "accountId",
    "provider",
    "status",
    "revision",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "account@1.0"
    },
    "accountId": {
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
    },
    "provider": {
      "description": "Provider driver kind bound to this account; immutable.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "status": {
      "enum": [
        "new",
        "ready",
        "reauth-required",
        "challenge",
        "disabled"
      ]
    },
    "login": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "credentials"
          ]
        },
        "credentialRef": {
          "description": "Id of the encrypted credential record (never inline secrets here).",
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "codeProviders": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "totp-local",
              "manual",
              "imap"
            ]
          }
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "mode": {
            "const": "credentials"
          }
        }
      },
      "then": {
        "properties": {
          "credentialRef": true
        },
        "required": [
          "credentialRef"
        ]
      }
    },
    "identityHash": {
      "description": "sha256 of the driver's identity() hint; used to detect duplicate identities.",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/sha256"
    },
    "verifiedAt": {
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
    },
    "statusEvidence": {
      "description": "Evidence for the current status, e.g. 'login-url', 'login-surface', 'cf-challenge'.",
      "type": "string",
      "maxLength": 200
    },
    "state": {
      "description": "Portable authenticated state for the driver's stateOrigins only.",
      "type": "object",
      "required": [
        "origins",
        "cookies",
        "capturedAt"
      ],
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 256
          }
        },
        "cookies": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object"
          }
        },
        "localStorage": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object"
          }
        },
        "indexedDB": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "captured",
                "kept-previous",
                "absent"
              ]
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "capturedAt": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "state": true,
          "verifiedAt": true,
          "identityHash": true
        },
        "required": [
          "state",
          "verifiedAt",
          "identityHash"
        ]
      }
    }
  ],
  "additionalProperties": false
}

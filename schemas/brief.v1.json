{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:brief:v1",
  "title": "Brief",
  "description": "Body of an `objective` artifact: what one Worker run is given (PROP-0010). It carries pointers to artifacts by content id, never their content; the Worker source resolves them when it renders the brief into its own prompt format (design/workflow-engine.md#briefs). 1.1 adds `instructions`.",
  "type": "object",
  "required": ["schema", "goal", "acceptance", "artifacts", "budget", "sandbox", "classification"],
  "properties": {
    "schema": { "enum": ["brief@1.0", "brief@1.1"] },
    "projectId": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "taskId": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
          "statement": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/shortText" }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "description": "Pointers to what the Worker should read, by content id.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["ref", "role"],
        "properties": {
          "ref": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef" },
          "role": {
            "description": "input: the material to work on; context: background; prior: an earlier attempt's result or digest; review: findings to address.",
            "enum": ["input", "context", "prior", "review"]
          },
          "note": { "type": "string", "maxLength": 300 }
        },
        "additionalProperties": false
      }
    },
    "instructions": {
      "description": "1.1: what the Worker is told, in order, as its template words it: text, and pointers placed by their index in `artifacts`, whose text the Worker source puts there when it renders the brief. The text is the template's, the caller's, and what the engine composed; never the content of an artifact the brief points to.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["text"],
            "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 262144 } },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["artifact"],
            "properties": { "artifact": { "description": "An index into `artifacts`.", "type": "integer", "minimum": 0, "maximum": 63 } },
            "additionalProperties": false
          }
        ]
      }
    },
    "subject": {
      "description": "The exact subject the run starts from, e.g. the worktree's commit.",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/subject"
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/shortText" }
    },
    "budget": {
      "description": "What the run may still draw: per pool, and a deadline.",
      "type": "object",
      "required": ["remaining"],
      "properties": {
        "remaining": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/budgetLine" }
        },
        "deadline": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "description": "The confinement the run is held to, from trusted configuration, never from model text.",
      "type": "object",
      "required": ["mode", "network"],
      "properties": {
        "mode": { "enum": ["read-only", "workspace-write"] },
        "workspace": {
          "description": "Absolute path of the run's workspace (a git worktree per writing task).",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "network": {
          "description": "none, or only the hosts the egress policy allows.",
          "enum": ["none", "allow-list"]
        },
        "commands": {
          "description": "Whether the Worker may run commands, inside the confinement.",
          "type": "boolean"
        }
      },
      "if": { "properties": { "mode": { "const": "workspace-write" } } },
      "then": { "required": ["workspace"], "properties": { "workspace": true } },
      "additionalProperties": false
    },
    "resume": {
      "description": "The agent's own session to resume, when the runtime keeps one.",
      "type": "object",
      "required": ["nativeHandle"],
      "properties": {
        "nativeHandle": { "type": "string", "minLength": 1, "maxLength": 256 },
        "fork": { "description": "Fork the session instead of continuing it (a reviewer reads a copy).", "type": "boolean" }
      },
      "additionalProperties": false
    },
    "classification": {
      "description": "At least the strictest classification of the artifacts it points at (INV-12).",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/classification"
    }
  },
  "dependentRequired": { "taskId": ["projectId"] },
  "if": { "properties": { "instructions": { "type": "array" } }, "required": ["instructions"] },
  "then": { "description": "@1.1 fields (instructions) are refused before @1.1.", "properties": { "schema": { "const": "brief@1.1" } } },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:message:v1",
  "title": "Peer message",
  "description": "Body of a 'message' artifact sent directly between Worker sessions (ADR-0015). Maps to an A2A Message.",
  "type": "object",
  "required": ["schema", "messageId", "from", "to", "body"],
  "properties": {
    "schema": { "const": "message@1.0" },
    "messageId": { "description": "Sender-unique id; receivers deduplicate on it.", "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "from": { "description": "Sender SessionId, 'operator', or 'client' (an MCP client holding the client scope, ADR-0023).", "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "to": {
      "type": "object",
      "properties": {
        "session": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
        "group": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "intent": { "enum": ["inform", "request", "critique", "answer", "handoff", "input-required", "close"] },
    "inReplyTo": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "body": { "type": "string", "minLength": 1, "maxLength": 32000 },
    "refs": {
      "description": "Artifacts the message points at instead of inlining them.",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef" }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:plan:v1",
  "title": "Plan",
  "description": "Body of a `plan` artifact: nodes a planner node proposes to append to its run's DAG (design/workflow-engine.md#graph-growth). The engine validates it before appending anything; writing steps wait for an approval bound to this exact plan.",
  "type": "object",
  "required": ["schema", "runId", "planner", "nodes", "confidence"],
  "properties": {
    "schema": { "const": "plan@1.0" },
    "runId": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "planner": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["nodeId", "objective", "prompt", "capabilities", "tier", "dependsOn"],
        "properties": {
          "nodeId": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
          "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 32000 },
          "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/capability" } },
          "tier": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tier" },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" } }
        },
        "additionalProperties": false
      }
    },
    "confidence": { "enum": ["low", "medium", "high"] }
  },
  "additionalProperties": false
}

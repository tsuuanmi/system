{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:decision:v1",
  "title": "Decision record",
  "description": "Body of a 'decision' artifact: one decision with its inputs, candidates, decider and outcome (INV-13). @1.1 adds team votes: the decision type 'vote' with its `vote` record, and the 'client' decider (a caller's deciding vote). @1.2 adds a review's quote checks: the `blocking-finding` method and round end, findings' reporters, kind, quote, class and why, and the vote's repository and unread count.",
  "type": "object",
  "required": [
    "schema",
    "decisionType",
    "question",
    "inputs",
    "candidates",
    "decider",
    "outcome",
    "deterministic"
  ],
  "properties": {
    "schema": {
      "enum": [
        "decision@1.0",
        "decision@1.1",
        "decision@1.2",
        "decision@1.3"
      ]
    },
    "decisionType": {
      "enum": [
        "admission",
        "route",
        "tier",
        "escalation",
        "egress",
        "acceptance",
        "gate",
        "reconciliation",
        "graph-growth",
        "recovery",
        "spec-admission",
        "vote",
        "retention"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef"
      }
    },
    "candidates": {
      "description": "Every option considered, including rejected ones with reasons.",
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "required": [
          "option",
          "selected",
          "reasons"
        ],
        "properties": {
          "option": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "selected": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decider": {
      "type": "object",
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "enum": [
            "rule",
            "policy",
            "model",
            "operator",
            "client"
          ]
        },
        "id": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "hash": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "modelAnswers": {
      "description": "Answers from a decision model, when one contributed (PROP-0002).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "modelVersion",
          "questionId",
          "type"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "maxLength": 64
          },
          "modelVersion": {
            "type": "string",
            "maxLength": 64
          },
          "questionSetVersion": {
            "type": "string",
            "maxLength": 64
          },
          "questionId": {
            "type": "string",
            "maxLength": 64
          },
          "type": {
            "enum": [
              "choice",
              "score",
              "yes-no"
            ]
          },
          "choice": {
            "type": "string",
            "maxLength": 128
          },
          "score": {
            "type": "number"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "option"
      ],
      "properties": {
        "option": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "detail": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "deterministic": {
      "description": "false when a model contributed; reproducibility then comes from reuse by input hash.",
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "maxLength": 1000
    },
    "vote": {
      "description": "A team's vote (decision type 'vote'): a tally's round, or the team's final decision with every round (docs/design/teams.md).",
      "type": "object",
      "required": [
        "kind",
        "threshold",
        "members",
        "options",
        "rounds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "brainstorm",
            "review"
          ]
        },
        "method": {
          "enum": [
            "team-majority",
            "caller-tiebreak",
            "inconclusive",
            "blocking-finding"
          ]
        },
        "threshold": {
          "description": "A strict majority of every member: a missing ballot never lowers it.",
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "members": {
          "description": "By opaque identity, never by provider.",
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "member",
              "identity"
            ],
            "properties": {
              "member": {
                "type": "string",
                "pattern": "^m[1-5]$"
              },
              "identity": {
                "type": "string",
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "option",
              "text"
            ],
            "properties": {
              "option": {
                "type": "string",
                "maxLength": 16
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              },
              "member": {
                "type": "string",
                "pattern": "^m[1-5]$"
              },
              "ref": {
                "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef"
              }
            },
            "additionalProperties": false
          }
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/round"
          }
        },
        "dissent": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "member",
              "choice",
              "objections",
              "strongest"
            ],
            "properties": {
              "member": {
                "type": "string",
                "pattern": "^m[1-5]$"
              },
              "choice": {
                "type": "string",
                "maxLength": 16
              },
              "objections": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "strongest": {
                "type": "object",
                "maxProperties": 4,
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            },
            "additionalProperties": false
          }
        },
        "revisions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "member",
              "round",
              "revision"
            ],
            "properties": {
              "member": {
                "type": "string",
                "pattern": "^m[1-5]$"
              },
              "round": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "revision": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "additionalProperties": false
          }
        },
        "tiebreak": {
          "description": "The deciding vote on a tie, or the rule that ended it.",
          "type": "object",
          "required": [
            "by",
            "option",
            "rationale"
          ],
          "properties": {
            "by": {
              "enum": [
                "client",
                "operator",
                "rule"
              ]
            },
            "option": {
              "type": "string",
              "maxLength": 16
            },
            "rationale": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "additionalProperties": false
        },
        "findings": {
          "description": "A review's findings, merged in member order.",
          "type": "array",
          "maxItems": 250,
          "items": {
            "type": "object",
            "required": [
              "id",
              "member",
              "severity",
              "claim",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^F[0-9]+$"
              },
              "member": {
                "type": "string",
                "pattern": "^m[1-5]$"
              },
              "severity": {
                "enum": [
                  "blocking",
                  "warning",
                  "info"
                ]
              },
              "claim": {
                "type": "string",
                "maxLength": 4000
              },
              "evidence": {
                "type": "string",
                "maxLength": 4000
              },
              "location": {
                "type": "string",
                "maxLength": 300
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "pattern": "^m[1-5]$"
                }
              },
              "kind": {
                "enum": [
                  "defect",
                  "suggestion"
                ]
              },
              "quote": {
                "type": "object",
                "required": [
                  "path",
                  "line",
                  "text"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "matched": {
                    "description": "The line the quote was found on, when it was.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              },
              "class": {
                "enum": [
                  "confirmed",
                  "needs-verification",
                  "suggestion"
                ]
              },
              "why": {
                "type": "string",
                "maxLength": 300
              },
              "reports": {
                "description": "Each member's own report on the finding's line, one per member (a member's several findings there fold into one): its claim, severity, and class. Only a report that is both confirmed and blocking decides a review by rule; the finding's own claim, severity, and class are its lead report's.",
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": [
                    "member",
                    "severity",
                    "claim"
                  ],
                  "properties": {
                    "member": {
                      "type": "string",
                      "pattern": "^m[1-5]$"
                    },
                    "severity": {
                      "enum": [
                        "blocking",
                        "warning",
                        "info"
                      ]
                    },
                    "claim": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "class": {
                      "enum": [
                        "confirmed",
                        "needs-verification",
                        "suggestion"
                      ]
                    },
                    "why": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "repository": {
          "type": "object",
          "required": [
            "url",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2000
            },
            "ref": {
              "type": "string",
              "maxLength": 200
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        "unread": {
          "description": "Files of the repository the members were not shown.",
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "description": "The confirmed blocking findings that decided a review `changes` (method blocking-finding).",
          "type": "array",
          "maxItems": 250,
          "items": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "description": "Exactly the outcome option is marked selected.",
      "properties": {
        "candidates": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": {
              "selected": {
                "const": true
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "if": {
        "properties": {
          "decider": {
            "properties": {
              "type": {
                "const": "model"
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "modelAnswers"
        ],
        "properties": {
          "modelAnswers": {
            "type": "array",
            "minItems": 1
          },
          "deterministic": {
            "const": false
          }
        }
      }
    },
    {
      "description": "@1.1 fields (a vote, the client decider) are refused on @1.0; a vote decision carries its vote.",
      "if": {
        "anyOf": [
          {
            "properties": {
              "decisionType": {
                "const": "vote"
              }
            },
            "required": [
              "decisionType"
            ]
          },
          {
            "properties": {
              "vote": {
                "type": "object"
              }
            },
            "required": [
              "vote"
            ]
          },
          {
            "properties": {
              "decider": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "client"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "decider"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "schema": {
            "enum": [
              "decision@1.1",
              "decision@1.2",
              "decision@1.3"
            ]
          },
          "vote": {
            "type": "object"
          }
        },
        "required": [
          "vote"
        ]
      }
    },
    {
      "description": "@1.2 fields (a review's quote checks) are refused on @1.0 and @1.1.",
      "if": {
        "properties": {
          "vote": {
            "type": "object",
            "anyOf": [
              {
                "properties": {
                  "method": {
                    "const": "blocking-finding"
                  }
                },
                "required": [
                  "method"
                ]
              },
              {
                "properties": {
                  "repository": {
                    "type": "object"
                  }
                },
                "required": [
                  "repository"
                ]
              },
              {
                "properties": {
                  "unread": {
                    "type": "integer"
                  }
                },
                "required": [
                  "unread"
                ]
              },
              {
                "properties": {
                  "findings": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "anyOf": [
                        {
                          "properties": {
                            "members": {
                              "type": "array"
                            }
                          },
                          "required": [
                            "members"
                          ]
                        },
                        {
                          "properties": {
                            "class": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "class"
                          ]
                        },
                        {
                          "properties": {
                            "why": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "why"
                          ]
                        },
                        {
                          "properties": {
                            "kind": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "properties": {
                            "quote": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "quote"
                          ]
                        },
                        {
                          "properties": {
                            "reports": {
                              "type": "array"
                            }
                          },
                          "required": [
                            "reports"
                          ]
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "findings"
                ]
              },
              {
                "properties": {
                  "rounds": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "properties": {
                        "ended": {
                          "const": "blocking-finding"
                        }
                      },
                      "required": [
                        "ended"
                      ]
                    }
                  }
                },
                "required": [
                  "rounds"
                ]
              },
              {
                "properties": {
                  "blocking": {
                    "type": "array"
                  }
                },
                "required": [
                  "blocking"
                ]
              }
            ]
          }
        },
        "required": [
          "vote"
        ]
      },
      "then": {
        "properties": {
          "schema": {
            "enum": [
              "decision@1.2",
              "decision@1.3"
            ]
          }
        }
      }
    },
    {
      "description": "@1.3: a retention decision (a released session's website conversations deleted) is refused before @1.3.",
      "if": {
        "properties": {
          "decisionType": {
            "const": "retention"
          }
        },
        "required": [
          "decisionType"
        ]
      },
      "then": {
        "properties": {
          "schema": {
            "const": "decision@1.3"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "ballot": {
      "type": "object",
      "required": [
        "member",
        "ref",
        "choice",
        "ranking",
        "rationale",
        "evidence",
        "strongest",
        "objections",
        "confidence"
      ],
      "properties": {
        "member": {
          "type": "string",
          "pattern": "^m[1-5]$"
        },
        "ref": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef"
        },
        "choice": {
          "type": "string",
          "maxLength": 16
        },
        "ranking": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 16
          }
        },
        "rationale": {
          "type": "string",
          "maxLength": 4000
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "strongest": {
          "type": "object",
          "maxProperties": 4,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "objections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "misstated": {
          "type": "string",
          "maxLength": 4000
        },
        "findings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^F[0-9]+$"
          },
          "additionalProperties": {
            "enum": [
              "agree",
              "disagree",
              "unsure"
            ]
          }
        },
        "crux": {
          "type": "string",
          "maxLength": 4000
        },
        "revision": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "round": {
      "type": "object",
      "required": [
        "round",
        "ballots",
        "counts",
        "winner",
        "ended"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "ballots": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/ballot"
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "winner": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "ended": {
          "enum": [
            "majority",
            "no-objections",
            "rounds-exhausted",
            "debate",
            "blocking-finding"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}

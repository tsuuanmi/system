{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:work-requirement:v1",
  "title": "Work requirement",
  "description": "What a unit of work needs; input to routing (design/routing.md).",
  "type": "object",
  "required": ["schema", "objective", "capabilities", "data", "egressPolicy", "tier", "acceptance"],
  "properties": {
    "schema": { "const": "work-requirement@1.0" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/capability" }
    },
    "data": {
      "type": "object",
      "required": ["classification", "refs"],
      "properties": {
        "classification": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/classification" },
        "refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef" } }
      },
      "additionalProperties": false
    },
    "egressPolicy": {
      "description": "Policy id from a trusted envelope (INV-6, INV-12).",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
    },
    "tier": {
      "type": "object",
      "required": ["min", "source"],
      "properties": {
        "min": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tier" },
        "max": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tier" },
        "source": { "enum": ["profile", "caller", "decision", "default"] },
        "decision": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef" }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxTokens": { "type": "integer", "minimum": 1 },
        "preferQuota": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/quotaClass" } }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["contract"],
      "properties": {
        "contract": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id" },
        "resultSchema": { "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/schemaTag" },
        "maxEscalations": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

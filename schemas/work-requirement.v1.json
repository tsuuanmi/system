{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsuuanmi:system:schema:work-requirement:v1",
  "title": "Work requirement",
  "description": "What a unit of work needs; input to routing (design/routing.md).",
  "type": "object",
  "required": [
    "schema",
    "objective",
    "capabilities",
    "data",
    "egressPolicy",
    "tier",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "enum": ["work-requirement@1.0", "work-requirement@1.1", "work-requirement@1.2", "work-requirement@1.3"]
    },
    "prefers": {
      "description": "1.3 adds prefers: capabilities the work prefers but does not need (T262): an admitted Worker that proves every one of them ranks before one that does not, after the reserve key and before tier. Never a refusal and never a provider family. Set by the workflow engine from the admitted spec, never from model text (INV-6).",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/capability"
      }
    },
    "kind": {
      "description": "@1.2: the kind of work this is, for Workers the operator gives kinds (ADR-0057): such a Worker takes it only when it lists this kind, and takes no work that names none. Set by the workflow engine from the admitted spec (a template step, or the variant the caller chose), never from model text (INV-6).",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/workKind"
    },
    "scope": {
      "description": "@1.1: the kind of work this is, for capability offers scoped to it (ADR-0049): review-member, a step of a review team's member. Set by the workflow engine from the admitted spec, never by a template or model text (INV-6).",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/workScope"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/capability"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "classification",
        "refs"
      ],
      "properties": {
        "classification": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/classification"
        },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef"
          }
        }
      },
      "additionalProperties": false
    },
    "egressPolicy": {
      "description": "Policy id from a trusted envelope (INV-6, INV-12).",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
    },
    "boundaries": {
      "description": "Delegation boundaries: what the Worker must not do or touch (delegation contract).",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "effort": {
      "description": "Effort budget for agentic Workers (effort scaling).",
      "type": "object",
      "properties": {
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxSubWorkers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "maxMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "additionalProperties": false
    },
    "writes": {
      "description": "Subject this work may write (INV-15); absent means read-only.",
      "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/subject"
    },
    "tier": {
      "type": "object",
      "required": [
        "min",
        "source"
      ],
      "properties": {
        "min": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tier"
        },
        "max": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/tier"
        },
        "source": {
          "enum": [
            "profile",
            "caller",
            "decision",
            "default"
          ]
        },
        "decision": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "preferQuota": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/quotaClass"
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": [
        "contract"
      ],
      "properties": {
        "contract": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/id"
        },
        "resultSchema": {
          "$ref": "urn:tsuuanmi:system:schema:common:v1#/$defs/schemaTag"
        },
        "maxEscalations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "scope": { "type": "string" } }, "required": ["scope"] },
      "then": { "properties": { "schema": { "enum": ["work-requirement@1.1", "work-requirement@1.2", "work-requirement@1.3"] } } }
    },
    {
      "if": { "properties": { "kind": { "type": "string" } }, "required": ["kind"] },
      "then": { "properties": { "schema": { "enum": ["work-requirement@1.2", "work-requirement@1.3"] } } }
    },
    {
      "if": { "properties": { "prefers": { "type": "array" } }, "required": ["prefers"] },
      "then": { "description": "@1.3 fields (prefers) are refused before @1.3.", "properties": { "schema": { "const": "work-requirement@1.3" } } }
    }
  ]
}

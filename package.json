{
  "name": "system-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "pnpm check:docs && pnpm check:schemas && pnpm lint && pnpm typecheck",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:schemas": "tsx scripts/check-schemas.ts",
    "lint": "oxlint scripts spikes packages",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

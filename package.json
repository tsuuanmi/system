{
  "name": "system-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.18.1 || >=26.5.1"
  },
  "scripts": {
    "check": "\"$npm_execpath\" run check:docs && \"$npm_execpath\" run check:secrets && \"$npm_execpath\" run check:schemas && \"$npm_execpath\" run check:reference && \"$npm_execpath\" run check:packages && \"$npm_execpath\" run check:manifests && \"$npm_execpath\" run check:traceability && \"$npm_execpath\" run lint && \"$npm_execpath\" run typecheck",
    "check:docs": "node --import tsx scripts/check-docs.ts",
    "check:secrets": "node --import tsx scripts/check-secrets.ts",
    "check:schemas": "node --import tsx scripts/check-schemas.ts",
    "audit:deps": "\"$npm_execpath\" audit --prod --audit-level high",
    "lint": "oxlint scripts spikes packages",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:group": "node --import tsx scripts/test-groups.ts group",
    "test:affected": "node --import tsx scripts/test-groups.ts affected",
    "build": "\"$npm_execpath\" -r --filter \"./packages/**\" run build",
    "test:e2e": "\"$npm_execpath\" run build && vitest run -c vitest.e2e.config.ts",
    "gen:reference": "node --import tsx scripts/gen-reference.ts",
    "check:reference": "node --import tsx scripts/gen-reference.ts --check",
    "gen:packages": "node --import tsx scripts/gen-packages.ts",
    "check:packages": "node --import tsx scripts/gen-packages.ts --check",
    "gen:manifests": "node --import tsx scripts/gen-manifests.ts",
    "check:manifests": "node --import tsx scripts/gen-manifests.ts --check",
    "gen:traceability": "node --import tsx scripts/gen-traceability.ts",
    "check:traceability": "node --import tsx scripts/gen-traceability.ts --check",
    "gen:upgrade-fixture": "node --import tsx packages/cli/tests/upgrade/generate.ts",
    "test:crash": "\"$npm_execpath\" run build && vitest run -c vitest.crash.config.ts",
    "changeset": "changeset",
    "version-packages": "node --import tsx scripts/version-packages.ts",
    "release:artifacts": "node --import tsx scripts/release-artifacts.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}

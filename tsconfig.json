        "packages/plugins/agent-workers/src/index.ts"
      ],
      "@tsuuanmi/system-agent-runtimes": [
        "packages/plugins/agent-runtimes/src/index.ts"
      ],
      "@tsuuanmi/system-runtime-acp": [
        "packages/plugins/runtime-acp/src/index.ts"
      ],
      "@tsuuanmi/system-runtime-claude-agent-sdk": [
        "packages/plugins/runtime-claude-agent-sdk/src/index.ts"
      ],
      "@tsuuanmi/system-workflow": [
        "packages/plugins/workflow/src/index.ts"
      ],
      "@tsuuanmi/system-workers-core": [
        "packages/workers-core/src/index.ts"

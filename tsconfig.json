        "packages/plugins/artifacts/src/index.ts"
      ],
      "@tsuuanmi/system-credentials-vault": [
        "packages/plugins/credentials-vault/src/index.ts"
      ],
      "@tsuuanmi/system-mcp-server": [
        "packages/plugins/mcp-server/src/index.ts"
      ],
      "@tsuuanmi/system-leases": [
        "packages/plugins/leases/src/index.ts"
      ],
      "@tsuuanmi/system-event-log": [
        "packages/plugins/event-log/src/index.ts"
      ],
      "@tsuuanmi/system-blobs": [
        "packages/plugins/blobs/src/index.ts"
      ],
      "@tsuuanmi/system-provider-core": [
        "packages/provider-core/src/index.ts"
      ],
      "@tsuuanmi/system-turn-receipts": [
        "packages/plugins/turn-receipts/src/index.ts"
      ],
      "@tsuuanmi/system-accounts": [
        "packages/plugins/accounts/src/index.ts"
      ],
      "@tsuuanmi/system-display-virtual": [
        "packages/plugins/display-virtual/src/index.ts"
      ],
      "@tsuuanmi/system-browser-patchright": [
        "packages/plugins/browser-patchright/src/index.ts"
      ],
      "@tsuuanmi/system-ui-ops": [
        "packages/ui-ops/src/index.ts"
      ],
      "@tsuuanmi/system-provider-chatgpt-web": [
        "packages/plugins/provider-chatgpt-web/src/index.ts"
      ],
      "@tsuuanmi/system-providers": [
        "packages/plugins/providers/src/index.ts"
      ],
      "@tsuuanmi/system-login": [
        "packages/plugins/login/src/index.ts"
      ],
      "@tsuuanmi/system-turns": [
        "packages/plugins/turns/src/index.ts"

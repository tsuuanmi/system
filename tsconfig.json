{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@tsuuanmi/system-libs": [
        "packages/libs/src/index.ts"
      ],
      "@tsuuanmi/system-store": [
        "packages/plugins/store/src/index.ts"
      ],
      "@tsuuanmi/system-artifacts": [
        "packages/plugins/artifacts/src/index.ts"
      ],
      "@tsuuanmi/system-credentials-vault": [
        "packages/plugins/credentials-vault/src/index.ts"
      ],
      "@tsuuanmi/system-mcp-server": [
        "packages/plugins/mcp-server/src/index.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "spikes/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/tests/**/*.ts"
  ]
}

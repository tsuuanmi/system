{
  "name": "@tsuuanmi/system-web-ui",
  "version": "0.0.0",
  "private": true,
  "description": "The operator's web UI on the DSH webserver: runs, steps, decision chains, and approve, stop, continue; the approval queue's verdicts; the autonomy policy and the operator's proposed changes; the operator's acceptance of board reviews; the board's projects with the operator's pause, resume, and close; loopback and token-gated",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "plugin-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tsuuanmi/system-approvals-core": "workspace:*",
    "@tsuuanmi/system-board-core": "workspace:*",
    "@tsuuanmi/system-gateway-core": "workspace:*",
    "@tsuuanmi/system-ledger-core": "workspace:*",
    "@tsuuanmi/system-libs": "workspace:*",
    "@tsuuanmi/system-workers-core": "workspace:*",
    "@tsuuanmi/system-workflow": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@tsuuanmi/system-approvals": "workspace:*",
    "@tsuuanmi/system-artifacts": "workspace:*",
    "@tsuuanmi/system-board": "workspace:*",
    "@tsuuanmi/system-browser-patchright": "workspace:*",
    "@tsuuanmi/system-egress": "workspace:*",
    "@tsuuanmi/system-event-log": "workspace:*",
    "@tsuuanmi/system-lead-inbox": "workspace:*",
    "@tsuuanmi/system-leases": "workspace:*",
    "@tsuuanmi/system-store": "workspace:*",
    "@tsuuanmi/system-worker-sessions": "workspace:*",
    "@tsuuanmi/system-workers": "workspace:*",
    "patchright-core": "1.63.0",
    "yaml": "2.9.1"
  }
}

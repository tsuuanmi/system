{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-web-ui",
  "version": "0.0.0",
  "description": "The operator's web UI on the DSH webserver: runs, steps, decision chains, and approve, stop, continue; the approval queue's verdicts; the autonomy policy and the operator's proposed changes; the operator's acceptance of board reviews; the board's projects with the operator's pause, resume, and close; loopback and token-gated",
  "class": {
    "kind": "family",
    "family": "surface"
  },
  "provides": [],
  "consumes": [
    {
      "seam": "webServer",
      "range": "^1.0.0"
    },
    {
      "seam": "workflow",
      "range": "^1.11.0"
    },
    {
      "seam": "accounts",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "agentWorkers",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "approvals",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "artifacts",
      "range": "^1.2.0",
      "optional": true
    },
    {
      "seam": "board",
      "range": "^1.5.0",
      "optional": true
    },
    {
      "seam": "eventLog",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "resources",
      "range": "^1.3.0",
      "optional": true
    },
    {
      "seam": "workers",
      "range": "^1.0.0",
      "optional": true
    }
  ],
  "config": [
    {
      "key": "tokenDir",
      "sensitive": false
    },
    {
      "key": "allowedHosts",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

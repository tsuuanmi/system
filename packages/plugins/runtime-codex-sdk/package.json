{
  "name": "@tsuuanmi/system-runtime-codex-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Agent runtime codex-sdk: Codex as a Worker through the official Codex TypeScript SDK, on the operator's installed codex, held to its own sandbox (REQ-WRK-5)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "plugin-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.162.1",
    "@tsuuanmi/system-agent-runtime-core": "workspace:*",
    "@tsuuanmi/system-libs": "workspace:*",
    "@tsuuanmi/system-provider-core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  }
}

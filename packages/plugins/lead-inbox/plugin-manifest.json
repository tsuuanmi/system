{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-lead-inbox",
  "version": "0.0.0",
  "description": "A project's lead inbox, from recorded events only: what needs the lead (a result or merge held, a question, spent retries, a landing that gave up, a request outside the lead's rights or stale, idle quota) and what finished (a live update, a landing, a digest), as lead-notice@1.0 records addressed to lead:<project>; MCP lead_inbox, system lead wait, and push to a command's stdin or a file; deduplicated, bounded, its outcomes recorded",
  "class": {
    "kind": "family",
    "family": "surface"
  },
  "provides": [
    {
      "seam": "leadInbox",
      "version": "1.0.0"
    }
  ],
  "consumes": [
    {
      "seam": "store",
      "range": "^1.0.0"
    },
    {
      "seam": "eventLog",
      "range": "^1.1.0"
    },
    {
      "seam": "accounts",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "agentWorkers",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "approvals",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "board",
      "range": "^1.5.0",
      "optional": true
    },
    {
      "seam": "mcp",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "resources",
      "range": "^1.3.0",
      "optional": true
    },
    {
      "seam": "workers",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "workflow",
      "range": "^1.12.0",
      "optional": true
    }
  ],
  "config": [
    {
      "key": "kinds",
      "sensitive": false
    },
    {
      "key": "staleMinutes",
      "sensitive": false
    },
    {
      "key": "idleMinutes",
      "sensitive": false
    },
    {
      "key": "expiringHours",
      "sensitive": false
    },
    {
      "key": "link",
      "sensitive": false
    },
    {
      "key": "digestMinutes",
      "sensitive": false
    },
    {
      "key": "dedupMinutes",
      "sensitive": false
    },
    {
      "key": "maxAgeMinutes",
      "sensitive": false
    },
    {
      "key": "pollSeconds",
      "sensitive": false
    },
    {
      "key": "retainDays",
      "sensitive": false
    },
    {
      "key": "maxNotices",
      "sensitive": false
    },
    {
      "key": "maxQueue",
      "sensitive": false
    },
    {
      "key": "coordinationDir",
      "sensitive": false
    },
    {
      "key": "projects",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

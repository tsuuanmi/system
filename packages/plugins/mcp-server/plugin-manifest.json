{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-mcp-server",
  "version": "0.0.0",
  "description": "MCP Streamable HTTP endpoint on ctx.webServer for Claude Code and Codex: loopback, bearer token, no CORS (ADR-0011)",
  "class": {
    "kind": "family",
    "family": "surface"
  },
  "provides": [
    {
      "seam": "mcp",
      "version": "1.0.0"
    }
  ],
  "consumes": [
    {
      "seam": "webServer",
      "range": "^1.0.0"
    },
    {
      "seam": "accounts",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "agentWorkers",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "artifacts",
      "range": "^1.2.0",
      "optional": true
    },
    {
      "seam": "board",
      "range": "^1.3.0",
      "optional": true
    },
    {
      "seam": "browser",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "credentials",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "eventLog",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "pluginHost",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "providers",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "resources",
      "range": "^1.2.0",
      "optional": true
    },
    {
      "seam": "store",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "turns",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "workers",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "workflow",
      "range": "^1.9.0",
      "optional": true
    }
  ],
  "config": [
    {
      "key": "path",
      "sensitive": false
    },
    {
      "key": "tokenDir",
      "sensitive": false
    },
    {
      "key": "discoveryFile",
      "sensitive": false
    },
    {
      "key": "allowedHosts",
      "sensitive": false
    },
    {
      "key": "maxBodyBytes",
      "sensitive": false
    },
    {
      "key": "minFreeBytes",
      "sensitive": false
    },
    {
      "key": "driftWindowHours",
      "sensitive": false
    },
    {
      "key": "storeCheckMinutes",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

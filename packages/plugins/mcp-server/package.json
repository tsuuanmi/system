{
  "name": "@tsuuanmi/system-mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "MCP Streamable HTTP endpoint on ctx.webServer for Claude Code and Codex: loopback, bearer token, no CORS (ADR-0011)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "plugin-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tsuuanmi/system-gateway-core": "workspace:*",
    "@tsuuanmi/system-libs": "workspace:*",
    "@tsuuanmi/system-plugin-host-core": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@tsuuanmi/system-event-log": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@tsuuanmi/system-artifacts": "workspace:*",
    "@tsuuanmi/system-store": "workspace:*"

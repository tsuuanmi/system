{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-gateway-responses",
  "version": "0.0.0",
  "description": "OpenAI Responses gateway: Codex uses a website model as its model, each request a workflow run, the client's tools through a text protocol (ADR-0022)",
  "class": {
    "kind": "family",
    "family": "surface"
  },
  "provides": [],
  "consumes": [
    {
      "seam": "webServer",
      "range": "^1.0.0"
    },
    {
      "seam": "workflow",
      "range": "^1.12.0"
    },
    {
      "seam": "store",
      "range": "^1.0.0"
    }
  ],
  "config": [
    {
      "key": "path",
      "sensitive": false
    },
    {
      "key": "tokenDir",
      "sensitive": false
    },
    {
      "key": "allowedHosts",
      "sensitive": false
    },
    {
      "key": "models",
      "sensitive": false
    },
    {
      "key": "classification",
      "sensitive": false
    },
    {
      "key": "timeoutMs",
      "sensitive": false
    },
    {
      "key": "pingMs",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-worker-sessions",
  "version": "0.0.0",
  "description": "ctx.workerSessions: durable Worker sessions, groups, and mailboxes with direct peer messaging under a group policy and barriers (ADR-0015)",
  "class": {
    "kind": "core",
    "component": "work-state-machine"
  },
  "provides": [
    {
      "seam": "workerSessions",
      "version": "1.1.0"
    }
  ],
  "consumes": [
    {
      "seam": "store",
      "range": "^1.0.0"
    },
    {
      "seam": "artifacts",
      "range": "^1.0.0"
    },
    {
      "seam": "mcp",
      "range": "^1.0.0",
      "optional": true
    }
  ],
  "config": [
    {
      "key": "maxMessages",
      "sensitive": false
    },
    {
      "key": "maxTurns",
      "sensitive": false
    },
    {
      "key": "maxLifetimeMinutes",
      "sensitive": false
    },
    {
      "key": "maxIdleMinutes",
      "sensitive": false
    },
    {
      "key": "checkpointEveryTurns",
      "sensitive": false
    },
    {
      "key": "compactAtTokens",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

{
  "name": "@tsuuanmi/system-board",
  "version": "0.0.0",
  "private": true,
  "description": "ctx.board: projects with charters and board tasks across runs, in the store, with leases, expiring waits, approvals through ctx.approvals, board_* MCP tools, and a TASKS.md projection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "plugin-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tsuuanmi/system-approvals-core": "workspace:*",
    "@tsuuanmi/system-board-core": "workspace:*",
    "@tsuuanmi/system-gateway-core": "workspace:*",
    "@tsuuanmi/system-leases": "workspace:*",
    "@tsuuanmi/system-ledger-core": "workspace:*",
    "@tsuuanmi/system-libs": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@tsuuanmi/system-artifacts": "workspace:*",
    "@tsuuanmi/system-event-log": "workspace:*",
    "@tsuuanmi/system-store": "workspace:*",
    "zod": "^4.1.0"
  }
}

{
  "name": "@tsuuanmi/system-browser-patchright",
  "version": "0.0.0",
  "private": true,
  "description": "ctx.browser: one headed system Chrome per account on the invisible ctx.display, driven by patchright-core; fresh context per turn from portable state",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "chrome.lock.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.4",
    "@tsuuanmi/system-libs": "workspace:*",
    "@tsuuanmi/system-provider-core": "workspace:*",
    "patchright-core": "1.63.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@tsuuanmi/system-display-virtual": "workspace:*"
  }
}

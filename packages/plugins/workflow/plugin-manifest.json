{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-workflow",
  "version": "0.0.0",
  "description": "ctx.workflow: the single workflow engine (MVP subset: static DAGs, durable nodes, routing by capability, acceptance, recovery, teams that vote, runs that serve board tasks); contributes MCP ask, research, brainstorm, review, vote, run, result, usage, explain",
  "class": {
    "kind": "core",
    "component": "work-state-machine"
  },
  "provides": [
    {
      "seam": "workflow",
      "version": "1.6.0"
    }
  ],
  "consumes": [
    {
      "seam": "store",
      "range": "^1.0.0"
    },
    {
      "seam": "artifacts",
      "range": "^1.0.0"
    },
    {
      "seam": "eventLog",
      "range": "^1.0.0"
    },
    {
      "seam": "leases",
      "range": "^1.1.0"
    },
    {
      "seam": "egress",
      "range": "^1.0.0"
    },
    {
      "seam": "workers",
      "range": "^1.0.0"
    },
    {
      "seam": "workerSessions",
      "range": "^1.1.0"
    },
    {
      "seam": "approvals",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "board",
      "range": "^1.3.0",
      "optional": true
    },
    {
      "seam": "digests",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "mcp",
      "range": "^1.0.0",
      "optional": true
    },
    {
      "seam": "resources",
      "range": "^1.1.0",
      "optional": true
    }
  ],
  "config": [
    {
      "key": "templates",
      "sensitive": false
    },
    {
      "key": "maxAttempts",
      "sensitive": false
    },
    {
      "key": "retryDelayMs",
      "sensitive": false
    },
    {
      "key": "maxActiveRuns",
      "sensitive": false
    },
    {
      "key": "maxWaitingRuns",
      "sensitive": false
    },
    {
      "key": "retainDays",
      "sensitive": false
    },
    {
      "key": "allowSameFamily",
      "sensitive": false
    },
    {
      "key": "retainRunsDays",
      "sensitive": false
    },
    {
      "key": "maxLimitWaitHours",
      "sensitive": false
    },
    {
      "key": "autoApprovePlans",
      "sensitive": false
    },
    {
      "key": "maxReviewCycles",
      "sensitive": false
    },
    {
      "key": "tieTimeoutHours",
      "sensitive": false
    },
    {
      "key": "gateTimeoutHours",
      "sensitive": false
    },
    {
      "key": "approvalPollSeconds",
      "sensitive": false
    },
    {
      "key": "maxSessionRuns",
      "sensitive": false
    },
    {
      "key": "tasksFile",
      "sensitive": false
    },
    {
      "key": "digestsPerHour",
      "sensitive": false
    },
    {
      "key": "repositories",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-approvals",
  "version": "0.0.0",
  "description": "ctx.approvals: the autonomy policy and the one batched approval queue on ctx.store, with expiry that denies, and policy changes through a policy-change approval; MCP approvals_list, approvals_get, approvals_policy, and approvals_decide and approvals_policy_propose (operator)",
  "class": {
    "kind": "core",
    "component": "gate"
  },
  "provides": [
    {
      "seam": "approvals",
      "version": "1.1.0"
    }
  ],
  "consumes": [
    {
      "seam": "store",
      "range": "^1.0.0"
    },
    {
      "seam": "artifacts",
      "range": "^1.1.0"
    },
    {
      "seam": "eventLog",
      "range": "^1.1.0",
      "optional": true
    },
    {
      "seam": "mcp",
      "range": "^1.0.0",
      "optional": true
    }
  ],
  "config": [
    {
      "key": "policies",
      "sensitive": false
    },
    {
      "key": "sweepSeconds",
      "sensitive": false
    },
    {
      "key": "supersedes",
      "sensitive": false
    },
    {
      "key": "repeatedApprovals",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

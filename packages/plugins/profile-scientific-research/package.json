{
  "name": "@tsuuanmi/system-profile-scientific-research",
  "version": "0.0.0",
  "private": true,
  "description": "The scientific-research profile: hypotheses, a cited literature review, an evidence table, an independent critique, conclusions per hypothesis (templates contributed to the workflow engine, typed artifacts)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "plugin-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tsuuanmi/system-ledger-core": "workspace:*",
    "@tsuuanmi/system-libs": "workspace:*",
    "@tsuuanmi/system-workers": "workspace:*",
    "@tsuuanmi/system-workflow": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@tsuuanmi/system-artifacts": "workspace:*",
    "@tsuuanmi/system-event-log": "workspace:*"
  }
}

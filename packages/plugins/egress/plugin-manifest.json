{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-egress",
  "version": "0.0.0",
  "description": "ctx.egress: explicit data egress (INV-12): classification policy per remote Worker class plus a secret scan of the actual outgoing payload, each check an egress decision",
  "class": {
    "kind": "core",
    "component": "gate"
  },
  "provides": [
    {
      "seam": "egress",
      "version": "1.0.0"
    }
  ],
  "consumes": [
    {
      "seam": "artifacts",
      "range": "^1.2.0"
    }
  ],
  "config": [
    {
      "key": "workerClasses",
      "sensitive": false
    },
    {
      "key": "defaultClassification",
      "sensitive": false
    },
    {
      "key": "scanSecrets",
      "sensitive": false
    },
    {
      "key": "denyPatterns",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED"
}

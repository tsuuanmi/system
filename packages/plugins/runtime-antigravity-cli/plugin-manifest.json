{
  "schema": "plugin-manifest@1.0",
  "name": "@tsuuanmi/system-runtime-antigravity-cli",
  "version": "0.0.0",
  "description": "Agent runtime provider antigravity-cli: the Antigravity CLI (agy) as a Worker in print mode, every tool call held by a PreToolUse hook bridged to the run's gate",
  "class": {
    "kind": "family",
    "family": "worker"
  },
  "provides": [],
  "consumes": [
    {
      "seam": "agentRuntimes",
      "range": "^1.0.0"
    }
  ],
  "config": [
    {
      "key": "executable",
      "sensitive": false
    },
    {
      "key": "env",
      "sensitive": false
    },
    {
      "key": "forwardEnv",
      "sensitive": false
    },
    {
      "key": "home",
      "sensitive": false
    }
  ],
  "license": "UNLICENSED",
  "egress": "operator-shared"
}

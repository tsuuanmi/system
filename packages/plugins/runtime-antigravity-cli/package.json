{
  "name": "@tsuuanmi/system-runtime-antigravity-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Agent runtime provider antigravity-cli: the Antigravity CLI (agy) as a Worker in print mode, every tool call held by a PreToolUse hook bridged to the run's gate",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "files": ["lib", "hook", "plugin-manifest.json"],
  "scripts": { "build": "tsc -p tsconfig.build.json" },
  "dependencies": {
    "@tsuuanmi/system-agent-runtime-core": "workspace:*",
    "@tsuuanmi/system-libs": "workspace:*",
    "@tsuuanmi/system-provider-core": "workspace:*"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "4.0.5-alpha.1", "@deepseek-ai/schemastery": "3.18.5-alpha.1" },
  "devDependencies": { "@deepseek-ai/cordis": "4.0.5-alpha.1", "@deepseek-ai/schemastery": "3.18.5-alpha.1" }
}
